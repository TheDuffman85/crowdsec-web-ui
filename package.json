{
  "name": "crowdsec-web-ui",
  "version": "0.0.0",
  "description": "A web UI for CrowdSec alerts and decisions",
  "main": "dist/server/index.js",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "ensure:native-deps": "node scripts/ensure-native-deps.mjs",
    "prestart": "pnpm run ensure:native-deps",
    "start": "node dist/server/index.js",
    "predev": "pnpm run ensure:native-deps",
    "dev": "APP_VERSION=dev-$(date -u +'%Y%m%d%H%M'); VITE_VERSION=\"$APP_VERSION\" pnpm run dev:server & VITE_VERSION=\"$APP_VERSION\" pnpm run dev:client",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "loadtest:seed": "tsx scripts/seed-load-test-data.ts",
    "loadtest:server": "tsx scripts/load-test-server.ts",
    "loadtest:benchmark:multi": "node scripts/benchmark-multi-instance.mjs",
    "loadtest:build-client": "vite build",
    "geocoder:data": "node scripts/download-geonames-data.mjs",
    "install-all": "pnpm install",
    "build": "vite build && tsup",
    "test": "pnpm run test:server && pnpm run test:client",
    "pretest:server": "pnpm run ensure:native-deps",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:mtls:crowdsec": "node --experimental-strip-types scripts/crowdsec-mtls-smoke-test.mjs",
    "screenshots:update": "bash screenshots/update-screenshots.sh",
    "coverage": "pnpm run coverage:server && pnpm run coverage:client && pnpm run coverage:check",
    "precoverage:server": "pnpm run ensure:native-deps",
    "coverage:server": "vitest run --config vitest.server.config.ts --coverage",
    "coverage:client": "vitest run --config vitest.client.config.ts --coverage",
    "coverage:check": "node --experimental-strip-types scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint client eslint.config.js vite.config.ts vitest.config.ts vitest.server.config.ts vitest.client.config.ts tsup.config.ts",
    "verify": "pnpm run test && pnpm run coverage && pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@simplewebauthn/server": "^14.0.3",
    "@types/sortablejs": "^1.15.9",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.14",
    "i18next": "^26.5.10",
    "jose": "^6.2.12",
    "local-reverse-geocoder": "0.16.8",
    "mqtt": "^5.16.1",
    "openid-client": "^6.8.8",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.1.8",
    "sortablejs": "^1.15.7",
    "undici": "8.12.3",
    "ws": "8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/ibm-plex-sans-devanagari": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@nivo/core": "^0.99.0",
    "@nivo/geo": "^0.99.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "clsx": "^2.1.1",
    "d3-geo": "3.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "flag-icons": "^7.6.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.4",
    "react-window": "^2.5.0",
    "react-zoom-pan-pinch": "4.2.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
